#!/bin/sh
# hooks/pre-commit — runs lint before allowing a commit
# Installed by: npm install / npm run setup-hooks / node scripts/setup-hooks.mjs

set -e

# Only run in rolecraft project dir
PKG=$(node -p "require('./package.json').name" 2>/dev/null || echo "")
if [ "$PKG" != "rolecraft" ]; then
  exit 0
fi

# NOTE: this hook deliberately does NOT run `npm run generate:docs`.
#
# It used to, followed by `git add -A`. That put a freshly generated
# test_count / unpacked_size into every branch, and both values change on
# nearly every merge — so every open PR was stale by definition and
# MAINIFEST-MATRIX.md, README.md, CONTRIBUTING.md, benchmark/RESULTS.md and
# four docs/*.md conflicted on each one. Generated values are now owned by
# .github/workflows/docs-sync.yml, which refreshes them on main after merge.
# Feature branches must not carry them.
#
# If you add an agent or change the published file set, run
# `npm run generate:docs` yourself and commit the result, or let the
# post-merge workflow pick it up.

# Run lint (syntax + biome). Skip if biome not installed.
if [ -x node_modules/.bin/biome ]; then
  echo "→ pre-commit: running npm run lint"
  if ! npm run --silent lint; then
    echo "pre-commit: lint failed. Run 'npx biome check --write' to auto-fix." >&2
    exit 1
  fi
fi
