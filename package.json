{
  "name": "rolecraft",
  "version": "2.3.2",
  "description": "The package manager for AI agents — install, test, publish, and manage skills & MCP servers across 87 agents. Zero-dependency CLI for claude-code, cursor, opencode, omp, and more.",
  "type": "module",
  "bin": {
    "rolecraft": "bin/rolecraft.js"
  },
  "exports": {
    ".": {
      "import": "./src/index.js"
    }
  },
  "files": [
    "bin/",
    "!bin/**/*.test.js",
    "src/",
    "!src/**/*.test.js",
    "!src/**/*.test.mjs",
    "!src/**/__fixtures__/",
    "scripts/setup-hooks.mjs",
    "README.md",
    "LICENSE"
  ],
  "preferGlobal": true,
  "keywords": [
    "skill",
    "skills",
    "agent skills",
    "skill manager",
    "role",
    "cli",
    "agent",
    "ai",
    "rolecraft",
    "opencode",
    "claude-code",
    "cursor",
    "agentskill",
    "zero-dependency",
    "awesome",
    "awesome-list",
    "skill-installer",
    "skill-manager",
    "agent-skills",
    "skills-sh",
    "skills.sh",
    "mcp",
    "security",
    "security-scan",
    "security-scanner",
    "secure",
    "supply-chain",
    "llm",
    "code-assistant",
    "prompt",
    "dev-tools",
    "automation",
    "developer-experience",
    "gemini-cli",
    "codex",
    "copilot",
    "aider",
    "cline",
    "windsurf",
    "devin",
    "augment",
    "roo",
    "tabnine",
    "supermaven",
    "codeium",
    "continue",
    "fabric",
    "goose",
    "loom",
    "trae",
    "hermes",
    "kiro",
    "kiln",
    "openhands",
    "justin",
    "factory",
    "pr-pilot",
    "nodejs",
    "productivity",
    "developer-tools"
  ],
  "author": "Samet ÇELİKBIÇAK",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rolecraft-sh/rolecraft.git"
  },
  "bugs": {
    "url": "https://github.com/rolecraft-sh/rolecraft/issues"
  },
  "homepage": "https://rolecraft-sh.github.io/rolecraft/",
  "scripts": {
    "lint": "node --check bin/rolecraft.js src/**/*.js && biome check",
    "lint:fix": "biome check --write",
    "test": "node --test --test-concurrency=1",
    "test:coverage": "node --experimental-test-coverage --test --test-coverage-exclude=\"**/*.test.js\" --test-coverage-include=\"src/**\" --test-coverage-include=\"bin/**\"",
    "setup-hooks": "node scripts/setup-hooks.mjs",
    "postinstall": "node scripts/setup-hooks.mjs || true",
    "benchmark": "node benchmark/install-speed.js && node scripts/benchmark-visual.js",
    "benchmark:visual": "node scripts/benchmark-visual.js",
    "generate:agents-docs": "node scripts/generate-agents-docs.js",
    "generate:readme": "node scripts/generate-readme.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && node scripts/generate-sitemap.mjs",
    "docs:preview": "vitepress preview docs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "vite": "^6.4.3",
    "esbuild": "^0.25.0",
    "launch-editor": "^2.14.1"
  },
  "allowScripts": {}
}
