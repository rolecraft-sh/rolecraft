Output assets/demos/01-install-manage.gif

Set FontSize 15
Set Width 820
Set Height 520
Set Theme "Dracula"
Set Padding 20
Set Framerate 12

Sleep 2000ms

Type "rolecraft install rolecraft-sh/skills --yes --dry-run --cursor"
Sleep 300ms
Enter
Sleep 10000ms

Type "clear"
Sleep 200ms
Enter
Sleep 1500ms

Type "rolecraft list"
Sleep 300ms
Enter
Sleep 6000ms

Type "clear"
Sleep 200ms
Enter
Sleep 1500ms

Type "rolecraft check"
Sleep 300ms
Enter
Sleep 10000ms

Type "clear"
Sleep 200ms
Enter
Sleep 1500ms

Type "rolecraft rollback --help"
Sleep 300ms
Enter
Sleep 6000ms
